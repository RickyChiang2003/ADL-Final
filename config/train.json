{
  "data": {
    "file": "data/data.parquet",
    "batch_size": 1
  },
  "model": {
    "name": "Qwen/Qwen3-0.6B"
  },
  "train": {
    "iteration": 20,
    "epochs": 20,
    "learning_rate": 0.00001,
    "check_val_every_n_step": 10,
    "early_stopping": true,
    "patience": 2,
    "output_dir": "checkpoints/",
    "logs_dir": "logs/",
    "debug": true,
    "gradient_accumulation_steps": 8
  },
  "seed": 42
}
