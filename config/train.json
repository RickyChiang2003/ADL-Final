{
  "data": {
    "file": "data/data.parquet",
    "batch_size": 1
  },
  "train": {
    "iteration": 10,
    "epochs": 10,
    "learning_rate": 0.0005,
    "check_val_every_n_step": 10,
    "early_stopping": true,
    "patience": 2,
    "output_dir": "checkpoints/",
    "logs_dir": "logs/",
    "debug": false,
    "gradient_accumulation_steps": 8
  },
  "seed": 42
}
