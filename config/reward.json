{
  "data": {
    "file": "data/data.parquet",
    "batch_size": 1
  },
  "model": {
    "name": "Qwen/Qwen3-0.6B"
  },
  "train": {
    "epochs": 20,
    "learning_rate": 0.00003,
    "check_val_every_n_step": 10,
    "early_stopping": true,
    "patience": 3,
    "output_dir": "checkpoints/reward/",
    "logs_dir": "logs/reward/",
    "debug": true,
    "gradient_accumulation_steps": 8
  },
  "seed": 42
}
